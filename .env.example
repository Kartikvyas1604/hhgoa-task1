# FrameInGoa — backend environment
#
# This file is gitignored (see .gitignore: `.env*`) — safe to paste real
# secrets in here. Restart `next dev` after editing.
#
# Nothing in the app breaks if these are left blank: card generation,
# download, and the /share tweet-intent flow are 100% client-side already.
# Filling these in unlocks: a real persisted card record, a real sequential
# builder number, ImageKit-hosted images, and the /card/[id] page (with the
# 3D badge + a real X-preview OG image showing the actual generated card).

# --- Supabase ---------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# "service_role" secret key (server-only — never expose this to the client).
SUPABASE_SERVICE_ROLE_KEY=

# --- ImageKit ----------------------------------------------------------
# Developer Options in your ImageKit dashboard.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Site ---------------------------------------------------------------
# Used to build absolute share/OG URLs. Set to your deployed domain in
# production (e.g. https://frameingoa.vercel.app); localhost is fine for dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
